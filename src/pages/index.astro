---
import Advogados from "../components/Advogados.astro";
import Cabecalho from "../components/Cabecalho.astro";
import Heroi from "../components/Heroi.astro";
import Base from "../layouts/Base.astro";
import { NOME_DO_ESCRITORIO } from "../lib/copy";

/**
 * O one-pager. **Zero rota além da raiz**: endereçamento interno é sempre
 * fragmento, nunca rota.
 *
 * A ordem das sete seções é fixa — herói → áreas de atuação → confira seu
 * benefício → advogados → quem somos → mapa → rodapé. Existem o herói e os
 * advogados; as outras cinco chegam nos tickets seguintes, e o primeiro botão do
 * herói já aponta para o fragmento que *Confira seu benefício* vai ocupar.
 *
 * **Advogados vem antes das duas seções que ainda faltam entre ela e o herói**,
 * e isso é andaime, não mudança de ordem: quando *Áreas de atuação* (#33) e
 * *Confira seu benefício* (#31) chegarem, elas entram acima daqui.
 */
---

<Base
  titulo={`${NOME_DO_ESCRITORIO} — advocacia em fraude bancária contra beneficiários do INSS`}
  descricao="Escritório de direito bancário no Ceará. Entenda os descontos no seu benefício do INSS e descubra sozinho se o seu caso precisa de advogado."
>
  <Cabecalho />
  <main>
    <Heroi />
    <Advogados />
  </main>
</Base>
